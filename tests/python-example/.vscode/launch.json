{
    "configurations": [
        {
            "console": "integratedTerminal",
            "name": "Python Debugger: Current File",
            "program": "${file}",
            "request": "launch",
            "type": "debugpy"
        },
        {
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "name": "Python Debugger: Attach",
            "request": "attach",
            "type": "debugpy"
        },
        {
            "args": [
                "runserver"
            ],
            "django": true,
            "name": "Python Debugger: Django",
            "program": "${workspaceFolder}/manage.py",
            "request": "launch",
            "type": "debugpy"
        }
    ],
    "version": "0.2.0"
}
